#===============================================================================
# * Valerion Dex Exporter + Moves Category Integrator
#===============================================================================
require 'json'

def pbExportMovesData
  path_moves = "PBS/moves.txt"
  path_pokemon = "PBS/pokemon.txt"
  output_file = "moves_data.json"

  unless File.exist?(path_moves) && File.exist?(path_pokemon)
    pbMessage("Faltan archivos en la carpeta PBS")
    return
  end

  # 1. PASADA A: Diccionario de movimientos con Categoría
  moves_db = {}
  current_move_id = nil

  File.open(path_moves, "r:utf-8").each_line do |line|
    line = line.strip
    if line =~ /^\[(.+)\]$/
      current_move_id = $1
      moves_db[current_move_id] = { 
        "nombre_es" => current_move_id,
        "tipo" => "NORMAL", 
        "pot" => 0, 
        "pre" => 0, 
        "cat" => "Status",
        "desc" => ""
      }
      next
    end
    next if current_move_id.nil? || line.empty? || line.start_with?('#')

    if line.include?('=')
      key, value = line.split('=', 2).map(&:strip)
      case key
      when "Name"        then moves_db[current_move_id]["nombre_es"] = value
      when "Type"        then moves_db[current_move_id]["tipo"]      = value
      when "Power"       then moves_db[current_move_id]["pot"]       = value.to_i
      when "Accuracy"    then moves_db[current_move_id]["pre"]       = value.to_i
      when "TotalPP"     then moves_db[current_move_id]["pp"]        = value.to_i
      when "Category"    then moves_db[current_move_id]["cat"]       = value
      when "Description" then moves_db[current_move_id]["desc"]      = value
      end
    end
  end

  # 2. PASADA B: Cruzar con Pokemon (igual que antes pero añadiendo 'cat')
  pokemon_moves_db = {}
  current_pkm_id = nil

  File.open(path_pokemon, "r:utf-8").each_line do |line|
    line = line.strip
    if line =~ /^\[(.+)\]$/
      current_pkm_id = $1
      pokemon_moves_db[current_pkm_id] = { "nivel" => [], "mt" => [], "huevo" => [], "tutor" => [] }
      next
    end
    next if current_pkm_id.nil? || line.empty?
    
    if line.include?('=')
      key, value = line.split('=', 2).map(&:strip)
      case key
      when "Moves"
        value.split(',').each_slice(2) do |lvl, m_id|
          m_info = moves_db[m_id] || {}
          pokemon_moves_db[current_pkm_id]["nivel"] << {
            "nombre"     => m_id,
            "nombre_es"  => m_info["nombre_es"] || m_id,
            "nivel"      => lvl.to_i,
            "tipo"       => m_info["tipo"],
            "pot"        => m_info["pot"],
            "pre"        => m_info["pre"],
            "pp"         => m_info["pp"],
            "cat"        => m_info["cat"],
            "desc"       => m_info["desc"]
          }
        end
      when "TutorMoves", "EggMoves"
        tipo_json = (key == "TutorMoves" ? "mt" : "huevo")
        value.split(',').each do |m_id|
          m_id.strip!
          m_info = moves_db[m_id] || {}
          pokemon_moves_db[current_pkm_id][tipo_json] << {
            "nombre"     => m_id,
            "nombre_es"  => m_info["nombre_es"] || m_id,
            "tipo"       => m_info["tipo"],
            "pot"        => m_info["pot"],
            "pre"        => m_info["pre"],
            "pp"         => m_info["pp"],
            "cat"        => m_info["cat"],
            "desc"       => m_info["desc"]
          }
        end
      end
    end
  end

  File.open(output_file, "w") { |f| f.write(JSON.pretty_generate(pokemon_moves_db)) }
  pbMessage(_INTL("¡moves_data.json generado con categorías!"))
end